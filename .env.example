# 复制本文件为 .env 后填入真实值：copy .env.example .env
# 这个文件列出 Docker Compose 部署所需的全部环境变量

# ========== MySQL ==========
# MySQL root 密码（docker-compose 中 mysql 服务会使用）
MYSQL_PASSWORD=请改成你的强密码

# 数据库连接串（主机名 mysql 是 Docker 网络内的服务名，不是 localhost）
DATABASE_URL=mysql+pymysql://root:请改成你的强密码@mysql:3306/enterprise_kb

# ========== JWT 认证 ==========
# JWT 签名密钥（生产环境请用随机强密码，例如 PowerShell 执行：-join ((48..57)+(65..90) | Get-Random -Count 32 | % {[char]$_})）
JWT_SECRET=请改成随机强密码

# 后端代码读取的环境变量名是 SECRET_KEY，与 JWT_SECRET 保持一致即可
SECRET_KEY=请改成随机强密码

# ========== ChromaDB 向量库 ==========
# ChromaDB 在容器内的持久化目录（与 docker-compose 卷挂载目标路径一致）
CHROMA_PERSIST_DIRECTORY=/app/chroma_data

# ========== Ollama 大模型（运行在 Windows 宿主机，不在 Docker 里）==========
# 容器内通过 host.docker.internal 访问 Windows 上的 Ollama
OLLAMA_EMBEDDING_URL=http://host.docker.internal:11434/api/embeddings
OLLAMA_GENERATE_URL=http://host.docker.internal:11434/api/generate
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_TIMEOUT=180
OLLAMA_GENERATE_TIMEOUT=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP_ENABLED=true

# ========== 文本分块（RAG）==========
# 分块策略：flat（单层，默认）| parent_child（父子块，检索 child、LLM 看 parent）
# 切换后必须 reindex，见 docs/chunking.md
CHUNK_STRATEGY=flat
# 切换示例（取消注释并 reindex）：
# CHUNK_STRATEGY=parent_child
# flat 模式参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# parent_child 模式参数
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=30

# 检索侧 BM25 索引文本长度上限（parent_child 下应 >= CHILD_CHUNK_SIZE）
SEARCH_MAX_CHUNK_LENGTH=800
