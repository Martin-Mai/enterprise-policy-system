# 数据库连接字符串
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:YOUR-MYSQL-DATABASE-PASSWORD@127.0.0.1:3306/enterprise_kb

# JWT 签名密钥（生产环境请使用随机强密码，例如：openssl rand -hex 32）
SECRET_KEY=your-secret-key-change-in-production

# JWT 签名算法
ALGORITHM=HS256

# JWT 令牌过期时间（天）
ACCESS_TOKEN_EXPIRE_DAYS=7

# ========== 文本分块（RAG）==========
# 分块策略：flat（单层，默认）| parent_child（父子块，检索 child、LLM 看 parent）
# 切换后必须 reindex，见 docs/chunking.md
CHUNK_STRATEGY=flat
# 切换示例（取消注释并 reindex）：
# CHUNK_STRATEGY=parent_child
# flat 模式参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# parent_child 模式参数
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=30

# 检索侧 BM25 索引文本长度上限（parent_child 下应 >= CHILD_CHUNK_SIZE）
SEARCH_MAX_CHUNK_LENGTH=800
